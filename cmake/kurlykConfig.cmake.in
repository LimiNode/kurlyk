@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT TARGET Threads::Threads)
    find_dependency(Threads)
endif()
if(NOT TARGET OpenSSL::SSL OR NOT TARGET OpenSSL::Crypto)
    find_dependency(OpenSSL)
endif()
if(NOT TARGET CURL::libcurl)
    find_dependency(CURL)
endif()

if(@KURLYK_USE_STANDALONE_ASIO@)
    if(NOT TARGET asio::asio)
        find_path(KURLYK_ASIO_INCLUDE_DIR asio.hpp)
        if(NOT KURLYK_ASIO_INCLUDE_DIR)
            message(FATAL_ERROR
                "Kurlyk requires standalone Asio. Install Asio or set KURLYK_ASIO_INCLUDE_DIR."
            )
        endif()
        add_library(kurlyk_package_asio_headers INTERFACE IMPORTED)
        set_target_properties(kurlyk_package_asio_headers PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${KURLYK_ASIO_INCLUDE_DIR}"
            INTERFACE_COMPILE_DEFINITIONS ASIO_STANDALONE
        )
        add_library(asio::asio ALIAS kurlyk_package_asio_headers)
    endif()
else()
    find_dependency(Boost)
endif()

if(NOT TARGET simple_ws_server)
    if(@KURLYK_PACKAGE_BUNDLED_SIMPLE_WS@)
        set(KURLYK_SIMPLE_WS_INCLUDE_DIR
            "${PACKAGE_PREFIX_DIR}/include/kurlyk/third_party/simple-websocket-server"
        )
    else()
        find_path(KURLYK_SIMPLE_WS_INCLUDE_DIR client_ws.hpp)
    endif()
    if(NOT KURLYK_SIMPLE_WS_INCLUDE_DIR)
        message(FATAL_ERROR
            "Kurlyk requires Simple-WebSocket-Server. Install it or set KURLYK_SIMPLE_WS_INCLUDE_DIR."
        )
    endif()
    add_library(kurlyk_package_simple_ws_headers INTERFACE IMPORTED)
    set_target_properties(kurlyk_package_simple_ws_headers PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${KURLYK_SIMPLE_WS_INCLUDE_DIR}"
    )
    add_library(simple_ws_server ALIAS kurlyk_package_simple_ws_headers)
endif()

function(_kurlyk_define_package_proxy proxy_target dependency_target)
    if(NOT TARGET ${proxy_target})
        add_library(${proxy_target} INTERFACE IMPORTED)
        set_property(TARGET ${proxy_target} PROPERTY
            INTERFACE_LINK_LIBRARIES "${dependency_target}"
        )
    endif()
endfunction()

_kurlyk_define_package_proxy(kurlyk_package_curl CURL::libcurl)
_kurlyk_define_package_proxy(kurlyk_package_ssl OpenSSL::SSL)
_kurlyk_define_package_proxy(kurlyk_package_crypto OpenSSL::Crypto)
_kurlyk_define_package_proxy(kurlyk_package_threads Threads::Threads)
if(@KURLYK_USE_STANDALONE_ASIO@)
_kurlyk_define_package_proxy(kurlyk_package_asio asio::asio)
else()
    _kurlyk_define_package_proxy(kurlyk_package_asio Boost::boost)
endif()
_kurlyk_define_package_proxy(kurlyk_package_simple_ws simple_ws_server)

include("${CMAKE_CURRENT_LIST_DIR}/kurlykTargets.cmake")

check_required_components(kurlyk)
